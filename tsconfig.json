{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "."
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "packages/*/migrations/**/*.ts",
    "packages/web/build.ts",
    "scripts/**/*.ts",
    "spikes/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "**/node_modules/**",
    "**/dist/**",
    "spikes/m0/ui/src/**",
    "packages/web/src/**",
    "tests/e2e/**"
  ]
}
