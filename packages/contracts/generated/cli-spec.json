{
  "auto": {
    "base": "The CLI reads the task first and sends that read's as_of",
    "cwd": "The CLI's working folder",
    "request_id": "From --request-id, or generated and printed"
  },
  "common": [
    {
      "flag": "--json",
      "help": "Print the result, or the error, as one JSON document"
    },
    {
      "flag": "--input",
      "help": "Read the input JSON from a file or stdin",
      "value": "<file or ->"
    }
  ],
  "errors": {
    "ambiguous": {
      "class": "not_found",
      "exit": 3
    },
    "conflict": {
      "class": "conflict",
      "exit": 4
    },
    "cursor_expired": {
      "class": "not_found",
      "exit": 3
    },
    "forbidden": {
      "class": "forbidden",
      "exit": 5
    },
    "internal": {
      "class": "internal",
      "exit": 1
    },
    "invalid_input": {
      "class": "usage",
      "exit": 2
    },
    "launch_unknown": {
      "class": "not_found",
      "exit": 3
    },
    "not_found": {
      "class": "not_found",
      "exit": 3
    },
    "not_permitted": {
      "class": "forbidden",
      "exit": 5
    },
    "op_unknown": {
      "class": "version",
      "exit": 7
    },
    "read_only": {
      "class": "space",
      "exit": 8
    },
    "request_id_conflict": {
      "class": "conflict",
      "exit": 4
    },
    "service_unavailable": {
      "class": "service",
      "exit": 6
    },
    "space_unavailable": {
      "class": "space",
      "exit": 8
    },
    "too_large": {
      "class": "usage",
      "exit": 2
    },
    "unbound": {
      "class": "unbound",
      "exit": 9
    },
    "wrong_tool": {
      "class": "usage",
      "exit": 2
    }
  },
  "exitCodes": {
    "conflict": 4,
    "forbidden": 5,
    "internal": 1,
    "interrupted": 130,
    "not_found": 3,
    "partial": 10,
    "service": 6,
    "space": 8,
    "success": 0,
    "unbound": 9,
    "usage": 2,
    "version": 7
  },
