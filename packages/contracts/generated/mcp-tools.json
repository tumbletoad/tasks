{
  "tools": [
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "description": "Use often while working: log progress, evidence, decisions, blockers or questions on a task. kind note records a note for the user, only when the user asks for one.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "default": "progress",
            "description": "question flags it for the user; note: a note for the user",
            "enum": [
              "progress",
              "evidence",
              "decision",
              "blocker",
              "question",
              "note"
            ],
            "type": "string"
          },
          "links": {
            "description": "Links that back the entry",
            "items": {
              "additionalProperties": false,
              "properties": {
                "title": {
                  "description": "Link title",
                  "maxLength": 200,
                  "type": "string"
                },
                "url": {
                  "description": "URL",
                  "maxLength": 2048,
                  "type": "string"
                }
              },
              "required": [
                "title",
                "url"
              ],
              "type": "object"
            },
            "maxItems": 5,
            "type": "array"
          },
          "request_id": {
            "description": "New per intended change; reuse it only to retry that call",
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_-]{16,64}$",
            "type": "string"
          },
          "task": {
            "description": "Task ref (M-14) or ID; default: the bound task",
            "maxLength": 40,
            "type": "string"
          },
          "text": {
            "description": "The entry, in Markdown",
            "maxLength": 2000,
            "type": "string"
          }
        },
        "required": [
          "text",
          "request_id"
        ],
        "type": "object"
      },
      "name": "add_entry",
      "title": "Log on a task"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "description": "Use for work left for later and for items from email, chat or tickets: 1 to 25 tasks per call, never TODOs in files. Give a source's item its key (jira:KEY); a match answers exists, not a copy. Without area or project a task goes to the Inbox.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "cwd": {
            "description": "Your working folder, as an absolute path",
            "maxLength": 4096,
            "type": "string"
          },
          "mode": {
            "default": "apply",
            "description": "propose: ask the user to decide",
            "enum": [
              "apply",
              "propose"
            ],
            "type": "string"
          },
          "request_id": {
            "description": "New per intended change; reuse it only to retry that call",
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_-]{16,64}$",
            "type": "string"
          },
          "tasks": {
            "description": "The tasks to create, 1 to 25",
            "items": {
              "additionalProperties": false,
              "properties": {
                "area": {
                  "description": "Area name or slug",
                  "maxLength": 120,
                  "type": "string"
                },
                "context": {
                  "description": "Markdown context",
                  "maxLength": 8000,
                  "type": "string"
                },
                "due": {
                  "description": "ISO date or phrase: fri, +3d",
                  "maxLength": 40,
                  "type": "string"
                },
                "effort": {
                  "description": "Effort, such as S, M or L",
                  "maxLength": 20,
                  "type": "string"
                },
                "inbox": {
                  "description": "Put it in the Inbox for the user",
                  "type": "boolean"
                },
                "log": {
                  "description": "Log entry; also added to a matched task",
                  "maxLength": 2000,
                  "type": "string"
                },
                "on_existing": {
                  "description": "When a source key matches; default return",
                  "enum": [
                    "return",
                    "add_sources",
                    "create_new"
                  ],
                  "type": "string"
                },
                "place": {
                  "anyOf": [
                    {
                      "maxLength": 4096,
                      "pattern": "^(?:cwd$|\\/|[A-Za-z]:[\\\\/]|[\\\\/]{2})",
                      "type": "string"
                    },
                    {
                      "additionalProperties": false,
                      "properties": {
                        "path": {
                          "description": "Relative path inside the root",
                          "maxLength": 1024,
                          "type": "string"
                        },
                        "root": {
                          "description": "Root name or ID",
                          "maxLength": 120,
                          "type": "string"
                        }
                      },
                      "required": [
                        "root",
                        "path"
                      ],
                      "type": "object"
                    }
                  ],
                  "description": "Its folder: \"cwd\", an absolute folder, or root and path"
                },
                "priority": {
                  "description": "1 highest, 4 none",
                  "maximum": 4,
                  "minimum": 1,
                  "type": "integer"
                },
                "project": {
                  "description": "Project name or slug",
                  "maxLength": 120,
                  "type": "string"
                },
                "sources": {
                  "description": "Where it came from",
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "at": {
                        "description": "When it was sent",
                        "maxLength": 40,
                        "type": "string"
                      },
                      "key": {
                        "description": "<namespace>:<id>, such as jira:LUM-212",
                        "maxLength": 512,
                        "type": "string"
                      },
                      "kind": {
                        "description": "Source kind",
                        "enum": [
                          "email",
                          "chat",
                          "ticket",
                          "pr",
                          "issue",
                          "doc",
                          "calendar",
                          "session",
                          "web"
                        ],
                        "type": "string"
                      },
                      "title": {
                        "description": "Subject, chat or ticket title",
                        "maxLength": 200,
                        "type": "string"
                      },
                      "url": {
                        "description": "Link",
                        "maxLength": 2048,
                        "type": "string"
                      },
                      "who": {
                        "description": "Sender or counterpart",
                        "maxLength": 120,
                        "type": "string"
                      }
                    },
                    "required": [
                      "kind",
                      "title"
                    ],
                    "type": "object"
                  },
                  "maxItems": 10,
                  "type": "array"
                },
                "status": {
                  "description": "A status of the space; default open",
                  "maxLength": 40,
                  "type": "string"
                },
                "summary": {
                  "description": "One line: the next step",
                  "maxLength": 240,
                  "type": "string"
                },
                "title": {
                  "description": "Title",
                  "maxLength": 200,
                  "type": "string"
                },
                "waiting_on": {
                  "description": "Who or what it waits on",
                  "maxLength": 80,
                  "type": "string"
                }
              },
              "required": [
                "title"
              ],
              "type": "object"
            },
            "maxItems": 25,
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "tasks",
          "request_id"
        ],
        "type": "object"
      },
      "name": "add_tasks",
      "title": "Add tasks"
    },
