                      ],
                      "type": "object"
                    }
                  ],
                  "description": "Its folder: \"cwd\", an absolute folder, or root and path"
                },
                "priority": {
                  "description": "1 highest, 4 none",
                  "maximum": 4,
                  "minimum": 1,
                  "type": "integer"
                },
                "project": {
                  "description": "Project name or slug",
                  "maxLength": 120,
                  "type": "string"
                },
                "sources": {
                  "description": "Where it came from",
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "at": {
                        "description": "When it was sent",
                        "maxLength": 40,
                        "type": "string"
                      },
                      "key": {
                        "description": "<namespace>:<id>, such as jira:LUM-212",
                        "maxLength": 512,
                        "type": "string"
                      },
                      "kind": {
                        "description": "Source kind",
                        "enum": [
                          "email",
                          "chat",
                          "ticket",
                          "pr",
                          "issue",
                          "doc",
                          "calendar",
                          "session",
                          "web"
                        ],
                        "type": "string"
                      },
                      "title": {
                        "description": "Subject, chat or ticket title",
                        "maxLength": 200,
                        "type": "string"
                      },
                      "url": {
                        "description": "Link",
                        "maxLength": 2048,
                        "type": "string"
                      },
                      "who": {
                        "description": "Sender or counterpart",
                        "maxLength": 120,
