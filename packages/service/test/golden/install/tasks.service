# TT Tasks's service, written by `tasks service install`. Remove it with `tasks service uninstall`.
[Unit]
Description=TT Tasks service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
ExecStart=/home/mira/.local/share/tasks/current/bin/tasks serve
WorkingDirectory=%h
Environment=TASKS_SERVICE_MANAGER=systemd
Restart=on-failure
RestartSec=2
RestartPreventExitStatus=64 73
KillMode=mixed
TimeoutStopSec=15
# No ProtectHome, PrivateTmp or NoNewPrivileges: launched agents need the user's full home and tools.

[Install]
WantedBy=default.target
