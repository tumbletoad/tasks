# TT Tasks's service, written by `tasks service install`. Remove it with `tasks service uninstall`.
[Unit]
Description=TT Tasks service (TASKS_HOME=/home/mira/tasks-test)
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
ExecStart=/home/mira/tasks-test/current/bin/tasks serve
WorkingDirectory=%h
Environment=TASKS_SERVICE_MANAGER=systemd
Restart=on-failure
RestartSec=2
RestartPreventExitStatus=64 73
KillMode=mixed
TimeoutStopSec=15
# Background runs: each in a child cgroup of this unit, which the service manages itself.
Delegate=yes
# No ProtectHome, PrivateTmp or NoNewPrivileges: launched agents need the user's full home and tools.

[Install]
WantedBy=default.target
