<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- TTasks's service, written by `ttasks service install`. Remove it with `ttasks service uninstall`. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.ttasks.service</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/mira/.local/share/ttasks/current/bin/ttasks-launchd</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>TTASKS_SERVICE_MANAGER</key>
    <string>launchd</string>
  </dict>
  <key>WorkingDirectory</key>
  <string>/Users/mira</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>ExitTimeOut</key>
  <integer>15</integer>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>AbandonProcessGroup</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/mira/.ttasks/state/logs/service.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/mira/.ttasks/state/logs/service.stderr.log</string>
</dict>
</plist>
