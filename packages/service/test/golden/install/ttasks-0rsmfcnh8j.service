# TTasks's service, written by `ttasks service install`. Remove it with `ttasks service uninstall`.
[Unit]
Description=TTasks service (TTASKS_HOME=/home/mira/ttasks-test)
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
ExecStart=/home/mira/ttasks-test/current/bin/ttasks serve
WorkingDirectory=%h
Environment=TTASKS_SERVICE_MANAGER=systemd
Restart=on-failure
RestartSec=2
RestartPreventExitStatus=64 73
KillMode=mixed
TimeoutStopSec=15
# Background runs: each in a child cgroup of this unit, which the service manages itself.
Delegate=yes
# No ProtectHome, PrivateTmp or NoNewPrivileges: launched agents need the user's full home and tools.

[Install]
WantedBy=default.target
